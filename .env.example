# Telegram Bot 配置 (必填)
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TG_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 可选：烧饼论坛登录 Cookie（配置后自动开启每日 08:05 签到、查分与私信/回帖通知）
# SBSB_COOKIE="__Host-bbs_session=你的烧饼论坛Session值"

# 可选：NodeSeek 双阶段 AI 语义判定引擎配置（推荐直接在 .env 配置，无需在 TG 对话框输入 Key）
# AI_ENABLED=true
# AI_ENDPOINT=https://api.openai.com/v1
# AI_API_KEY=sk-your-openai-or-deepseek-api-key
# AI_MODEL=gpt-4o-mini
# AI_JUDGE_MODEL=gpt-4o-mini
# AI_ACCEPT_THRESHOLD=0.90

# 运行参数（可选）
# MONITOR_SOURCES=nodeseek,sbsb
# DATA_DIR=/app/data
